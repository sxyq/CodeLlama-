# Ollama GPU Gateway environment (copy to gateway.local.env on the server).
# gateway.local.env is gitignored — never put real IPs into this example.

# public entry (what every LAN client keeps using)
GATEWAY_LISTEN_HOST=0.0.0.0
GATEWAY_LISTEN_PORT=11434

# ollama backend after the loopback migration
GATEWAY_BACKEND_HOST=127.0.0.1
GATEWAY_BACKEND_PORT=11435

# image slot signal
GATEWAY_IMAGE_STATUS=http://127.0.0.1:8011/status
GATEWAY_IMAGE_WAIT_TIMEOUT=1800
GATEWAY_IMAGE_POLL=2

# injected default for embed-family when the client omitted keep_alive
# (compat verified: vectors returned, runner unloads immediately)
GATEWAY_EMBED_KEEP_ALIVE=0
