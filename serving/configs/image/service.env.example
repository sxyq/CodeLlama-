# Image service environment (copy to service.local.env on the server and edit).
# service.local.env is gitignored — never put real IPs into this example file.

# CORS allowed origins for the WebUI (comma separated, no wildcard)
IMAGE_ALLOWED_ORIGINS=http://SERVER_IP:8020

# lifecycle
IMAGE_IDLE_TIMEOUT=600

# unified queue (generations + edits share one slot)
IMAGE_QUEUE_MAX_CONCURRENT=1
IMAGE_QUEUE_MAX_PENDING=8
IMAGE_QUEUE_TIMEOUT_SECONDS=480

# temporary outputs (no long-term gallery)
IMAGE_OUTPUT_DIR=/home/syy/ai-serving/tmp/image-output
IMAGE_OUTPUT_RETENTION_SECONDS=1800
IMAGE_CLEANUP_INTERVAL_SECONDS=300
